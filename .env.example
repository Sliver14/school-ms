# Cryptographic Authentication Secret for Session Tokens
AUTH_SECRET=royal-heights-super-secret-salt-2026-portal-jwt-hmac-key

# Optional Next.js public metadata
NEXT_PUBLIC_SCHOOL_NAME="Royal Heights Secondary School"
NEXT_PUBLIC_SCHOOL_MOTTO="Excellence, Character & Leadership"
NEXT_PUBLIC_PORTAL_SESSION="2026/2027"
